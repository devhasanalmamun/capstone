# Comma-separated list of allowed frontend origins for CORS.
# localhost:5173 / 127.0.0.1:5173 are always allowed for local dev; this var
# ADDS to them. Set it in the Render dashboard (Environment) to your deployed
# frontend URL, e.g.:
#   CORS_ORIGINS=https://your-frontend.onrender.com
CORS_ORIGINS=

# Optional: override the dataset path (defaults to data.csv at the repo root).
# DATA_CSV=/path/to/data.csv
